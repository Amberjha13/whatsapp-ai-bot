# ─── Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886   # Sandbox number

# ─── Anthropic (Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/whatsapp-bot

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Bot Personality (optional) ───────────────────────────────
BOT_NAME=Aria
BOT_SYSTEM_PROMPT=You are Aria, a helpful and friendly AI assistant for our business. Be concise, professional, and helpful. Keep replies under 200 words unless detail is needed.
